# One Local POS server. Copy to .env (git-ignored). Names only here; never commit values.
# Local development points at the Supabase CLI stack on OrbStack (API gateway :54321).
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Encrypts PAN and bank account numbers inside the database. 16+ characters. Required when NODE_ENV=production.
PARTNER_PII_KEY=
# Optional: Claude API key for "Write with AI" on the restaurant dish screen (unset = 503 ai_not_configured)
ANTHROPIC_API_KEY=
# Optional: remove.bg key for "Remove background (AI)" on the item form (unset = 503 bg_not_configured). REMOVE_BG_SIZE: auto (default), preview, full…
REMOVE_BG_API_KEY=
REMOVE_BG_SIZE=
# Optional: Google Maps Platform key for the map pin's address search and pin -> address (maps_search, maps_place, maps_reverse):
# Places API (New) and, for a street line at a dragged pin, the Geocoding API. Server only; unset = 503 maps_not_configured.
GOOGLE_MAPS_API_KEY=
PORT=8090
# Supabase Auth "Send SMS" hook (POST /hooks/send-sms): sign-in codes for both apps go out through apitxt.com.
# SEND_SMS_HOOK_SECRET = the "v1,whsec_..." value Supabase shows for the hook (locally: the same value as OL-ui/supabase/.env).
SEND_SMS_HOOK_SECRET=
# apitxt.com API key (Dashboard -> API Keys). Sign-in texts, and the PAN / GSTIN checks on the onboarding tax save (kyc.ts).
# Without it the app shows "Sign-in by SMS is not set up yet." for real numbers and tax details are saved unchecked.
APITXT_AUTH_KEY=
# Optional: the OTP template's id in the apitxt dashboard (unset = apitxt's default OTP template). Optional APITXT_BASE_URL for tests.
APITXT_OTP_TEMPLATE_ID=
# Set to 1 only on the host that is meant to use a hosted Supabase project. Without it the server refuses non-local URLs.
ALLOW_REMOTE=
# Number of trusted reverse-proxy hops in front of this server (for per-address limits). Default 0 locally, 1 in production.
TRUSTED_PROXY_HOPS=
# Comma-separated browser origins allowed to call this server (Flutter web only). Empty = no CORS headers.
CORS_ORIGINS=
