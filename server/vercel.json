{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build:vercel",
  "installCommand": "npm ci",
  "outputDirectory": "public",
  "rewrites": [
    {
      "source": "/t/:code([0-9a-f]{32,128})",
      "destination": "/t/index.html"
    },
    {
      "source": "/m/:slug([a-z0-9][a-z0-9-]{0,62})",
      "destination": "/t/index.html"
    },
    {
      "source": "/r/:slug([a-z0-9][a-z0-9-]{0,62})",
      "destination": "/t/index.html"
    },
    {
      "source": "/:slug((?!(?:privacy|terms|delete-account|join|auth|api|m|t|b|r|guest|rpc|health|admin|partner|partners|app|static|assets|www|help|support|about|login|signup|signin|onelocal|source|ol-api|webhooks|download|blog|careers|contact|master|rider|riders|store|stores)$)[a-z0-9][a-z0-9-]{0,62})",
      "destination": "/t/index.html"
    },
    {
      "source": "/(.*)",
      "destination": "/api/index"
    }
  ],
  "functions": {
    "api/index.js": {
      "maxDuration": 30
    }
  },
  "regions": [
    "bom1"
  ]
}
