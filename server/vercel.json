{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build:vercel",
  "installCommand": "npm ci",
  "outputDirectory": "public",
  "rewrites": [
    {
      "source": "/t/:code([0-9a-f]{32,128})",
      "destination": "/t/index.html"
    },
    {
      "source": "/m/:slug([a-z0-9][a-z0-9-]{0,62})",
      "destination": "/t/index.html"
    },
    {
      "source": "/(.*)",
      "destination": "/api/index"
    }
  ],
  "functions": {
    "api/index.js": {
      "maxDuration": 30
    }
  },
  "regions": [
    "bom1"
  ]
}
