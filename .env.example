# Copy to .env.local (git-ignored) and run:
#   flutter run --dart-define-from-file=.env.local
# Values only in .env.local, never in git. Names only here.
#
# The app picks the backend at start-up (lib/api/app_env.dart):
#   - LOCAL is used when its POS server answers /health (you run the local Supabase stack and `npm run dev` in server/).
#   - otherwise HOSTED is used (a friend who cloned the repo without the local stack).
#   - APP_ENV=local or APP_ENV=hosted forces one and skips the check.
# A server and its Supabase always go together: a sign-in on one database is not valid on the other.

# Local stack (from `supabase status` and server/.env)
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_PUBLISHABLE_KEY=<local publishable key>
PARTNER_API_BASE_URL=http://localhost:8090

# Hosted (ask the team for these values; the publishable key is the client key, never the service-role key)
HOSTED_SUPABASE_URL=https://<project-ref>.supabase.co
HOSTED_SUPABASE_PUBLISHABLE_KEY=<hosted publishable key>
HOSTED_PARTNER_API_BASE_URL=https://<pos-server>.vercel.app

# Optional: local | hosted
APP_ENV=

# Google Maps key that shows the map pin (business address, new outlet): Maps SDK for Android, Maps SDK for iOS and Maps JavaScript
# API (web). It ships inside the app, so restrict it in Google Cloud to this app (Android package + SHA-1, iOS bundle id, web address).
# Empty = the screens show the illustrative map. Address search and pin -> address use the POS server's GOOGLE_MAPS_API_KEY instead.
GOOGLE_MAPS_KEY=
